PORT=8080
NODE_ENV=development
DEFAULT_PHONE_REGION=CA
DATA_FILE_PATH=../data/locations.json
HISTORY_LIMIT=1000

# Required in Cloud Run. If omitted locally, the JSON file above is used.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main

# Set this as a custom X-Webhook-Secret header in email-webhook.com.
WEBHOOK_SECRET=

# Required by /test-location outside development. Sent as X-Test-Token.
TEST_TOKEN=

# off | metadata | raw. Use raw only briefly while inspecting the first delivery.
DIAGNOSTIC_MODE=off
LOG_LEVEL=info
